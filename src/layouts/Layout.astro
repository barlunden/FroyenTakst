---
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import ContactDrawer from "../components/ContactDrawer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const { 
  title = "Frøyen Takst", 
  description = "",
  image = "/images/froyenTakst.png" // Sørg for at dette matchar filnamnet nøyaktig
} = Astro.props;
const canonicalImageURL = new URL(image, Astro.url);
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalImageURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={canonicalImageURL} />
    <meta property="og:locale" content="nb_NO" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={canonicalImageURL} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Frøyen Takst" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body
    class="min-h-screen bg-gray-50 text-slate-800 antialiased flex flex-col"
  >
    <NavBar />

    <main class="flex-1 pt-28">
      <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8 py-12">
        <slot />
      </div>
    </main>

    <Footer />

    <ContactDrawer />

    <script type="module">
      // Flytta meny-logikken til ein funksjon som toler View Transitions
      function setupMenu() {
        const toggle = document.getElementById("menu-toggle");
        const menu = document.getElementById("mobile-menu");
        if (toggle && menu) {
          toggle.addEventListener("click", () => {
            menu.classList.toggle("hidden");
          });
        }
      }
      setupMenu();
      document.addEventListener("astro:after-swap", setupMenu);
    </script>
  </body>
</html>
