---
import "../styles/global.css";
const { title = "Frøyen Takst", description = "" } = Astro.props;
---

<!doctype html>
<html lang="nb">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        {
            description && (
                <meta property="og:description" content={description} />
            )
        }
        <meta property="og:image" content="/froyen_logo.webp" />
        <meta property="og:locale" content="nb_NO" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        {
            description && (
                <meta name="twitter:description" content={description} />
            )
        }
        <meta name="twitter:image" content="/froyen_logo.webp" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>

    <body
        class="min-h-screen bg-gray-50 text-slate-800 antialiased flex flex-col"
    >
        <!-- Header -->
        <header class="bg-white/60 backdrop-blur-sm border-b sticky top-0 z-50">
            <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8">
                <div class="flex items-center justify-between h-28">
                    <a
                        href="/"
                        class="flex items-center gap-3 rounded-md shadow-slate-500/50 hover:scale-101 transition-all shadow-lg"
                    >
                        <!-- Logo image -->
                        <span
                            class="inline-flex items-center justify-center bg-[#0f3b66] rounded-md p-2"
                        >
                            <img
                                src="/froyen_logo.webp"
                                alt="Frøyen Takst"
                                class="site-logo h-14! md:h-18!"
                            />
                        </span>
                    </a>

                    <!-- Desktop nav -->
                    <nav class="hidden md:flex items-center gap-6 text-md">
                        <a href="/" class="text-slate-700 hover:text-[#0f3b66]"
                            >Forside</a
                        >
                        <a
                            href="/om"
                            class="text-slate-700 hover:text-[#0f3b66]"
                            >Om oss</a
                        >

                        <!-- Tjenester Dropdown -->
                        <div class="relative group">
                            <a
                                href="/tjenester"
                                class="text-slate-700 hover:text-[#0f3b66] flex items-center gap-1"
                            >
                                Tjenester
                                <svg
                                    class="h-4 w-4 transform transition-transform duration-200 group-hover:rotate-180"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </a>
                            <div
                                class="absolute hidden group-hover:block bg-white shadow-lg rounded-md top-full left-0 py-2 w-60 border z-10"
                            >
                                <a
                                    href="/tjenester/tilstandsrapport"
                                    class="block px-4 py-2 text-sm text-slate-700 hover:bg-gray-100"
                                    >Tilstandsrapport</a
                                >
                                <a
                                    href="/tjenester/reklamasjon-skadetakst"
                                    class="block px-4 py-2 text-sm text-slate-700 hover:bg-gray-100"
                                    >Reklamasjon og Skadetakst</a
                                >
                                <a
                                    href="/tjenester/verdi-lanetakst"
                                    class="block px-4 py-2 text-sm text-slate-700 hover:bg-gray-100"
                                    >Verdi- og Lånetakst</a
                                >
                                <a
                                    href="/tjenester/forenklet-lanetakst"
                                    class="block px-4 py-2 text-sm text-slate-700 hover:bg-gray-100"
                                    >Forenklet Lånetakst</a
                                >
                            </div>
                        </div>

                        <a
                            href="/prisliste"
                            class="text-slate-700 hover:text-[#0f3b66]"
                            >Prisliste</a
                        >
                        <a
                            href="/faq"
                            class="text-slate-700 hover:text-[#0f3b66]"
                            >Ofte stilte spørsmål</a
                        >
                        <a
                            href="/kontakt"
                            class="inline-flex items-center gap-2 px-3 py-2 bg-[#0f3b66] text-white! rounded-md shadow-sm hover:bg-[#0d3358]"
                            >Kontakt</a
                        >
                    </nav>

                    <!-- Mobile menu button -->
                    <div class="md:hidden">
                        <button
                            id="menu-toggle"
                            aria-label="Åpne meny"
                            class="p-2 rounded-md border bg-white"
                        >
                            <svg
                                class="h-5 w-5 text-slate-700"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 6h16M4 12h16M4 18h16"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Mobile nav (hidden by default) -->
            <div id="mobile-menu" class="md:hidden hidden border-t bg-white">
                <div class="px-4 py-4 space-y-2">
                    <a
                        href="/"
                        class="block py-2 text-slate-700 hover:text-[#0f3b66]"
                        >Hjem</a
                    >
                    <a
                        href="/om"
                        class="block py-2 text-slate-700 hover:text-[#0f3b66]"
                        >Om</a
                    >
                    <div>
                        <a
                            href="/tjenester"
                            class="block py-2 font-semibold text-slate-700"
                            >Tjenester</a
                        >
                        <div class="pl-4 border-l-2 border-slate-200">
                            <a
                                href="/tjenester/tilstandsrapport"
                                class="block py-2 text-slate-600 hover:text-[#0f3b66]"
                                >Tilstandsrapport</a
                            >
                            <a
                                href="/tjenester/reklamasjon-skadetakst"
                                class="block py-2 text-slate-600 hover:text-[#0f3b66]"
                                >Reklamasjon og Skadetakst</a
                            >
                            <a
                                href="/tjenester/verdi-lanetakst"
                                class="block py-2 text-slate-600 hover:text-[#0f3b66]"
                                >Verdi- og Lånetakst</a
                            >
                            <a
                                href="/tjenester/forenklet-lanetakst"
                                class="block py-2 text-slate-600 hover:text-[#0f3b66]"
                                >Forenklet Lånetakst</a
                            >
                        </div>
                    </div>
                    <a
                        href="/prisliste"
                        class="block py-2 text-slate-700 hover:text-[#0f3b66]"
                        >Prisliste</a
                    >
                    <a
                        href="/faq"
                        class="block py-2 text-slate-700 hover:text-[#0f3b66]"
                        >Ofte stilte spørsmål</a
                    >
                    <a
                        href="/kontakt"
                        class="block py-2 px-3 bg-[#0f3b66] text-white rounded-md w-max"
                        >Kontakt</a
                    >
                </div>
            </div>
        </header>

        <!-- Main content -->
        <main class="flex-1">
            <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8 py-12">
                <slot />
            </div>
        </main>

        <!-- Footer -->
        <footer class="bg-white/60 border-t">
            <div
                class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8 py-8 text-slate-600"
            >
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <div class="font-semibold text-slate-800">
                            Frøyen Takst
                        </div>
                        <div class="mt-2 text-sm">
                            Profesjonell taksering med vekt på kvalitet,
                            dokumentasjon og kundetillit.
                        </div>
                    </div>

                    <div>
                        <div class="font-medium text-slate-800">Tjenester</div>
                        <ul class="mt-2 text-sm space-y-1">
                            <li>
                                <a
                                    href="/tjenester/tilstandsrapport"
                                    class="hover:underline">Tilstandsrapport</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/tjenester/reklamasjon-skadetakst"
                                    class="hover:underline"
                                    >Reklamasjon og Skadetakst</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/tjenester/verdi-lanetakst"
                                    class="hover:underline"
                                    >Verdi- og Lånetakst</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/tjenester/forenklet-lanetakst"
                                    class="hover:underline"
                                    >Forenklet Lånetakst</a
                                >
                            </li>
                        </ul>
                    </div>

                    <div>
                        <div class="font-medium text-slate-800">Kontakt</div>
                        <div class="mt-2 text-sm">
                            Tlf: <a class="underline" href="tel:+4740099909"
                                >+47 400 99 909</a
                            ><br />
                            E-post: <a
                                class="underline"
                                href="mailto:thomas@froyentakst.no"
                                >thomas@froyentakst.no</a
                            ><br />
                            Org.nr: 917 309 906
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-slate-100 py-1">
                <div class="mt-2 text-center text-xs text-slate-500">
                    © {new Date().getFullYear()} Frøyen Takst — Alle rettigheter forbeholdes
                </div>
                <div class="mt-2 text-center text-xs text-slate-400">
                    Forsidebilde: <a
                        href="https://unsplash.com/@michaelfousert?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText"
                        class="underline hover:text-slate-500"
                        >Michael Fousert</a
                    > på <a
                        href="https://unsplash.com/photos/panorama-city-view-lE5-z4nTCTQ?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText"
                        class="underline hover:text-slate-500">Unsplash</a
                    >
                </div>
                <div class="my-2 text-center text-xs text-slate-400">
                    Nettsider utviklet av <a
                        href="https://cominoweb.no"
                        class="underline hover:text-slate-500">Comino Web AS</a
                    >
                </div>
            </div>
        </footer>

        <!-- Small inline script for toggling mobile menu -->
        <script type="module">
            const toggle = document.getElementById("menu-toggle");
            const menu = document.getElementById("mobile-menu");
            if (toggle && menu) {
                toggle.addEventListener("click", () => {
                    menu.classList.toggle("hidden");
                });
            }
        </script>
    </body>
</html>
