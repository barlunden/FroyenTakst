---
import Layout from "../layouts/Layout.astro";
const title = "Om — Frøyen Takst";
const description =
    "Frøyen Takst — Erfaring og faglig tilnærming. Vi leverer tilstandsrapporter, verdivurderinger og byggtekniske råd i Bergen og omegn.";
---

<Layout {title} {description}>
    <article class="prose prose-slate max-w-none">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold text-primary">
                Om Frøyen Takst
            </h1>
            <p class="mt-3 text-slate-600">
                Frøyen Takst AS eies og drives av Thomas Frøyen, autorisert
                tømrer, byggmester og takstmann med mer enn 20 års erfaring fra
                byggebransjen. Vi tilbyr grundige tilstandsrapporter og faglige
                vurderinger ved bolighandel, rehabilitering og prosjektering.
                Hovedsakelig opererer vi i Bergen og omegn, men vi tar oppdrag
                andre steder i landet ved behov.
            </p>
        </header>

        <section class="grid gap-8 md:grid-cols-2 mb-10">
            <div class="card">
                <h2 class="text-xl font-semibold mb-2">Vår erfaring</h2>
                <p class="text-sm text-slate-600 mb-3">
                    Vi har mange års erfaring innen taksering av bolig,
                    fritidsbolig og næringseiendom. Vårt arbeid bruker
                    anerkjente metoder og relevante standarder for å sikre
                    konsistente og dokumenterbare resultater.
                </p>
                <ul class="list-disc pl-5 text-sm text-slate-600 space-y-1">
                    <li>Boligtakst og verdivurdering</li>
                    <li>Tilstandsrapporter (TK, TEK-relevant dokumentasjon)</li>
                    <li>Skadetaksering for forsikringssaker</li>
                    <li>Næringstakst og arealvurdering</li>
                </ul>
            </div>

            <div class="card">
                <h2 class="text-xl font-semibold mb-2">Vår tilnærming</h2>
                <p class="text-sm text-slate-600 mb-3">
                    Vi legger vekt på åpenhet, god dokumentasjon og praktiske
                    råd. Rapportene våre er utformet for både fagfolk og private
                    kunder — med tydelige konklusjoner og konkrete forslag til
                    oppfølging ved behov.
                </p>
                <div class="mt-4">
                    <div class="badge">Trygghet</div>
                    <div class="badge mt-2">Faglig tyngde</div>
                    <div class="badge mt-2">Lokal kunnskap</div>
                </div>
            </div>
        </section>

        <section class="mb-10">
            <h2 class="text-2xl font-semibold mb-3">
                Kvalifikasjoner og sertifiseringer
            </h2>
            <p class="text-sm text-slate-600 mb-3">
                Våre takstmenn har relevant utdanning og nødvendige
                sertifiseringer. Vi holder oss oppdatert på regelverk,
                byggestandarder og markedstrender for å sikre at vurderingene
                våre er faglig solide.
            </p>

            <div class="grid md:grid-cols-3 gap-4 mt-4">
                <div class="p-4 border rounded">
                    <div class="font-semibold">Fagbakgrunn</div>
                    <div class="text-sm text-slate-600 mt-1">
                        Byggfaglig erfaring, ingeniørkompetanse og intern
                        opplæring.
                    </div>
                </div>
                <div class="p-4 border rounded">
                    <div class="font-semibold">Sertifiseringer</div>
                    <div class="text-sm text-slate-600 mt-1">
                        Kurs og godkjenninger innen taksering og
                        tilstandsvurdering.
                    </div>
                </div>
                <div class="p-4 border rounded">
                    <div class="font-semibold">Forsikring</div>
                    <div class="text-sm text-slate-600 mt-1">
                        Profesjonell ansvarsforsikring for alle oppdrag.
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-12">
            <h2 class="text-2xl font-semibold mb-3">Hvorfor velge oss?</h2>
            <ul class="list-disc pl-5 text-sm text-slate-600 space-y-2">
                <li>Presise og lettforståelige rapporter.</li>
                <li>Rask respons og effektiv saksbehandling.</li>
                <li>Klare råd for vedlikehold og videre oppfølging.</li>
                <li>Lokalkunnskap som gir realistiske verdianslag.</li>
            </ul>
        </section>

        <aside class="p-6 bg-white rounded-md shadow-soft text-center">
            <h3 class="text-lg font-semibold mb-2">Ta kontakt</h3>
            <p class="text-sm text-slate-600 mb-4">
                Ønsker du et uforpliktende tilbud eller mer informasjon? Ta
                kontakt, så finner vi løsningen som passer ditt behov.
            </p>
            <a href="/kontakt" class="btn btn-primary">Kontakt oss</a>
        </aside>
    </article>
</Layout>
