---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";

const title = "Kontakt — Frøyen Takst";
const description = "Kontakt Frøyen Takst for tilbud eller bestilling av taksering i Bergen og omegn. Rask respons og profesjonell service.";
---

<Layout {title} {description}>
    <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="grid md:grid-cols-5 gap-12 items-start">
            
            <div class="md:col-span-2 space-y-8">
                <header>
                    <h1 class="text-4xl font-extrabold text-primary mb-4 tracking-tight">
                        Kontakt oss
                    </h1>
                    <p class="text-lg text-slate-600 leading-relaxed">
                        Vi er klare til å hjelpe deg med taksering og tilstandsrapport. 
                        Send oss en henvendelse, så hører du fra oss innen kort tid.
                    </p>
                </header>

                <div class="space-y-6">
                    <div class="border-l-4 border-accent pl-6 py-2">
                        <h2 class="font-bold text-slate-900">Praktisk ved bestilling</h2>
                        <p class="text-sm text-slate-600 mt-2">
                            Oppgi gjerne adresse og hva slags type eiendom det gjelder, så kan vi gi deg et raskere estimat.
                        </p>
                    </div>
                    
                    <div class="card-base p-6 bg-slate-50/50">
                        <h2 class="font-bold text-slate-900 mb-2">Kontortid</h2>
                        <p class="text-sm text-slate-600">
                            Mandag–fredag: 08:00–16:00<br />
                            Helg: Etter avtale
                        </p>
                    </div>
                </div>
            </div>

            <div class="md:col-span-3">
                <section class="card-base p-8 md:p-10 shadow-xl border-slate-200">
                    <ContactForm />
                </section>
            </div>

        </div>
    </div>
</Layout>