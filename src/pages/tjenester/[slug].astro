---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro"; // Importér komponenten
import { getCollection, render } from "astro:content";
import ContactDrawer from "../../components/ContactDrawer.astro";

export async function getStaticPaths() {
  const tjenesteEntries = await getCollection("tjenester");
  return tjenesteEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article class="max-w-4xl mx-auto px-6 py-12">
    
    {/* Vi brukar PageHeader her òg. 
       Den hentar title frå frontmatter i .md-fila di. 
    */}
    <PageHeader 
      title={entry.data.title} 
      description={entry.data.description} 
    />

    <div class="prose prose-slate lg:prose-xl max-w-none 
      prose-headings:text-primary prose-headings:font-bold
      prose-li:marker:text-primary">
      <Content />
    </div>

    <aside class="cta-banner mt-20">
      <h3>
        Bestill {entry.data.title.toLowerCase()}
      </h3>
      <p>
        Trenger du hjelp med {entry.data.title.toLowerCase()}? Vi leverer grundige rapporter med rask levering i hele Bergen og omegn.
      </p>
      <button class="trigger-contact-drawer btn-white mt-6">Kontakt oss i dag</button>
    </aside>
    
  </article>
</Layout>