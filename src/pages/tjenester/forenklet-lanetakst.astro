---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import skisseBilde from "/public/images/forenkletLanetakst.jpg";

const title = "Forenklet Lånetakst — Frøyen Takst";
const description =
    "En forenklet lånetakst er et rimeligere alternativ for finansiering av bolig. Frøyen Takst tilbyr rask og effektiv taksering for ditt lånebehov.";
---

<Layout {title} {description}>
    <article class="max-w-4xl mx-auto prose lg:prose-lg">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold text-primary">
                Forenklet Lånetakst
            </h1>
        </header>

        <figure class="mb-8">
            <Image
                src={skisseBilde}
                alt="En enkel, stilisert tegning av et hus, som symboliserer en forenklet prosess."
                class="rounded-md shadow-lg w-full"
            />
            <figcaption class="text-center text-sm text-slate-500 mt-2">
                En rask og kostnadseffektiv løsning for låneformål.
            </figcaption>
        </figure>

        <section>
            <p>
                En forenklet lånetakst er en enklere utgave av den mer
                omfattende verdi- og lånetaksten. Denne takstformen blir kun
                benyttet i forbindelse med finansiering av boligeiendommer og er
                et rimeligere alternativ.
            </p>
            <p>
                Rapporten har en kortfattet beskrivelse av eiendommen. Arealet
                blir angitt som et samlet bruksareal (BRA) for hver bygning; det
                blir ikke skilt mellom primær- og sekundærareal, og bruttoareal
                blir ikke beskrevet.
            </p>
            <p>
                Priser for våre tjenester, samt timepris og tillegg, finner du
                på vår <a href="/prisliste">prisliste</a>.
            </p>
        </section>

        <aside
            class="mt-12 p-6 bg-white rounded-md shadow-soft not-prose text-center"
        >
            <h3 class="text-lg font-semibold mb-2">
                Trenger du en forenklet lånetakst?
            </h3>
            <p class="text-sm text-slate-600 mb-4">
                Dette er ofte alt banken trenger for å vurdere lånesøknaden din.
                Kontakt oss for en rask og effektiv taksering.
            </p>
            <a href="/kontakt" class="btn btn-primary"
                >Bestill forenklet lånetakst</a
            >
        </aside>
    </article>
</Layout>
