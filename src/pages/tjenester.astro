---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Hent alle tenester og sorter dei etter 'order'
const tjenester = await getCollection("tjenester");
const sorterteTjenester = tjenester.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const title = "Tjenester — Frøyen Takst";
const description = "Frøyen Takst tilbyr profesjonell taksering i Bergen og omegn: Tilstandsrapporter, verdivurderinger og skadetaksering.";
---

<Layout {title} {description}>
    <article class="max-w-4xl mx-auto px-4 py-12">
        <header class="mb-12 text-center">
            <h1 class="text-3xl md:text-5xl font-extrabold text-primary">
                Våre tjenester
            </h1>
            <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
                Vi tilbyr en rekke takseringstjenester for å gi deg trygghet ved bolighandel, skadesaker eller finansiering.
            </p>
        </header>

        <section class="grid gap-6 mb-16">
            {sorterteTjenester.map((tjeneste) => (
                <div class="group bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-[#0f3b66]/30 transition-all flex flex-col sm:flex-row items-start sm:items-center gap-6">
                    <div class="flex-1">
                        <h2 class="text-xl font-bold text-slate-900 group-hover:text-primary transition-colors">
                            {tjeneste.data.title}
                        </h2>
                        <p class="mt-2 text-slate-600 leading-relaxed">
                            {tjeneste.data.description}
                        </p>
                    </div>
                    <a 
                        href={`/tjenester/${tjeneste.slug}`} 
                        class="btn-outline"
                    >
                        Les mer
                    </a>
                </div>
            ))}
        </section>

        <aside class="p-10 bg-primary rounded-3xl text-center text-white shadow-xl">
            <h3 class="text-2xl font-bold text-white! mb-3">Finner du ikke det du leter etter?</h3>
            <p class="text-blue-100/80! mb-8 max-w-md mx-auto">
                Vi utfører også andre typer taksering og vurderinger. Ta kontakt for en uforpliktende prat om ditt behov.
            </p>
            <a href="/kontakt" class="inline-block bg-white text-primary font-extrabold py-3 px-10 rounded-xl hover:scale-105 transition-transform shadow-lg">
                Kontakt oss
            </a>
        </aside>
    </article>
</Layout>