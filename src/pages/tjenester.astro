---
import Layout from "../layouts/Layout.astro";
const title = "Tjenester — Frøyen Takst";
const description =
    "Frøyen Takst — Tilstandsrapporter, verdivurderinger og skadetaksering. Profesjonell taksering i Bergen med tydelige rapporter og over 20 års erfaring.";
---

<Layout {title} {description}>
    <article class="max-w-4xl mx-auto">
        <header class="mb-8 text-center">
            <h1 class="text-3xl md:text-4xl font-bold text-primary">
                Våre tjenester
            </h1>
            <p class="mt-3 text-slate-600 max-w-2xl mx-auto">
                Vi tilbyr en rekke takseringstjenester for å gi deg trygghet ved bolighandel, skadesaker eller finansiering. Nedenfor finner du en oversikt over våre mest brukte tjenester.
            </p>
        </header>

        <section class="space-y-6 mb-10">
            <!-- Tilstandsrapport -->
            <div class="card p-6 flex flex-col sm:flex-row items-start gap-6">
                <div class="flex-1">
                    <h2 class="text-xl font-semibold">Tilstandsrapport ved salg av bolig</h2>
                    <p class="mt-2 text-sm text-slate-600">
                        Rapporten brukes for å kontrollere bygningsdeler der det kan oppstå konflikt mellom kjøper og selger.
                    </p>
                </div>
                <a href="/tjenester/tilstandsrapport" class="btn btn-outline mt-2 sm:mt-0">Les mer</a>
            </div>

            <!-- Reklamasjon/Skadetakst -->
            <div class="card p-6 flex flex-col sm:flex-row items-start gap-6">
                <div class="flex-1">
                    <h2 class="text-xl font-semibold">Reklamasjon/Skadetakst</h2>
                    <p class="mt-2 text-sm text-slate-600">
                        Skadeskjønn sikrer et profesjonelt og grundig grunnlag for eventuelle erstatningssaker.
                    </p>
                </div>
                <a href="/tjenester/reklamasjon-skadetakst" class="btn btn-outline mt-2 sm:mt-0">Les mer</a>
            </div>

            <!-- Verdi-/lånetakst -->
            <div class="card p-6 flex flex-col sm:flex-row items-start gap-6">
                <div class="flex-1">
                    <h2 class="text-xl font-semibold">Verdi-/lånetakst</h2>
                    <p class="mt-2 text-sm text-slate-600">
                        Når vi utfører verdi- og lånetakst anslår vi verdien av både bygningsmasse og tomt.
                    </p>
                </div>
                <a href="/tjenester/verdi-laanetakst" class="btn btn-outline mt-2 sm:mt-0">Les mer</a>
            </div>

            <!-- Forenklet lånetakst -->
            <div class="card p-6 flex flex-col sm:flex-row items-start gap-6">
                <div class="flex-1">
                    <h2 class="text-xl font-semibold">Forenklet lånetakst</h2>
                    <p class="mt-2 text-sm text-slate-600">
                        En forenklet lånetakst er en enklere utgave av verdi- og lånetaksten.
                    </p>
                </div>
                <a href="/tjenester/forenklet-laanetakst" class="btn btn-outline mt-2 sm:mt-0">Les mer</a>
            </div>
        </section>

        <aside class="p-6 bg-white rounded-md shadow-soft text-center">
            <h3 class="text-lg font-semibold mb-2">Finner du ikke det du leter etter?</h3>
            <p class="text-sm text-slate-600 mb-4">
                Vi utfører også andre typer taksering og vurderinger. Ta kontakt for en uforpliktende prat om ditt behov.
            </p>
            <a href="/kontakt" class="btn btn-primary">Kontakt oss</a>
        </aside>
    </article>
</Layout>
