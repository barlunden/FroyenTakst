---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { getCollection } from "astro:content";

// Hent alle tenester og sorter dei etter 'order'
const tjenester = await getCollection("tjenester");
const sorterteTjenester = tjenester.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const title = "Tjenester — Frøyen Takst";
const description = "Frøyen Takst tilbyr profesjonell taksering i Bergen og omegn: Tilstandsrapporter, verdivurderinger og skadetaksering.";
---

<Layout {title} {description}>
    <article class="max-w-6xl mx-auto px-4 py-16 md:py-24">
        
        {/* Her brukar vi komponenten i staden for vanleg HTML-header */}
        <PageHeader 
            title="Våre tjenester" 
            description="Vi tilbyr en rekke takseringstjenester for å gi deg trygghet ved bolighandel, skadesaker eller finansiering." 
        />

        <section class="grid gap-6 mb-16">
            {sorterteTjenester.map((tjeneste) => (
                <div class="group bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-primary/30 transition-all flex flex-col sm:flex-row items-start sm:items-center gap-6">
                    <div class="flex-1">
                        <h2 class="text-xl font-bold text-slate-900 group-hover:text-primary transition-colors">
                            {tjeneste.data.title}
                        </h2>
                        <p class="mt-2 text-slate-600 leading-relaxed">
                            {tjeneste.data.description}
                        </p>
                    </div>
                    <a 
                        href={`/tjenester/${tjeneste.slug}`} 
                        class="btn-outline"
                    >
                        Les mer
                    </a>
                </div>
            ))}
        </section>

        <aside class="p-10 bg-primary rounded-3xl text-center text-whiteshadow-xl">
            <h3 class="text-2xl font-bold text-white! italic mb-3">Finner du ikke det du leter etter?</h3>
            <p class="text-blue-100/80! mb-8 max-w-md mx-auto">
                Vi utfører også andre typer taksering og vurderinger. Ta kontakt for en uforpliktende prat om ditt behov.
            </p>
            <button class="trigger-contact-drawer btn-white">Kontakt oss</button>
        </aside>
    </article>
</Layout>