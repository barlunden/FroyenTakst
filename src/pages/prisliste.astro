---
import Layout from "../layouts/Layout.astro";
import priserData from "../data/priser.json";

// TypeScript-definisjonar for å fjerne alle feilmeldingar
interface PrisElement {
  navn: string;
  pris: string;
  bold?: boolean;
  italic?: boolean;
}

interface KortType {
  label: string;
  pris: string;
}

interface TjenesteKort {
  tittel: string;
  info?: string;
  pris?: string;
  enhet?: string;
  typer?: KortType[];
}

interface PrisData {
  tabellPriser: {
    kategori: string;
    elementer: PrisElement[];
    fotnote?: string;
  }[];
  tilleggsBygg: {
    tittel: string;
    navn: string;
    pris: string;
  };
  tjenesteKort: TjenesteKort[];
}

const priser = priserData as PrisData;
const title = "Prisliste — Frøyen Takst";
const description = "Prisliste for tjenester fra Frøyen Takst: verdi- og lånetakst, forenklet lånetakst, og reklamasjon/skadetakst i Bergen og omegn.";
---

<Layout {title} {description}>
  <article class="max-w-6xl mx-auto px-4 py-12">
    <header class="mb-8 text-center md:text-left">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">Prisliste</h1>
      <p class="mt-3 text-slate-600">
        Her er en oversikt over våre priser. Alle priser er inkludert mva.
      </p>
    </header>

    <section class="mb-12">
      <div class="overflow-hidden border border-gray-200 rounded-xl shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 bg-white">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Priskategori
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Pris (kr)
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {priser.tabellPriser.map((kat) => (
              <>
                <tr class="bg-slate-50/50">
                  <td colspan="2" class="px-6 py-3 text-sm font-bold text-slate-900 uppercase tracking-wide">
                    {kat.kategori}
                  </td>
                </tr>
                {kat.elementer.map((item) => (
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class={`px-6 py-3 text-sm text-gray-700 ${item.bold ? 'font-bold' : ''} ${item.italic ? 'italic' : ''}`}>
                      {item.navn}
                    </td>
                    <td class="px-6 py-3 text-sm font-semibold text-gray-900 whitespace-nowrap">
                      {item.pris}
                    </td>
                  </tr>
                ))}
                {kat.fotnote && (
                  <tr>
                    <td colspan="2" class="px-6 py-3 text-xs text-slate-500 italic leading-relaxed bg-white">
                      {kat.fotnote}
                    </td>
                  </tr>
                )}
              </>
            ))}
            
            {/* Tilleggsbygg-seksjon */}
            <tr class="bg-slate-50/50">
              <td colspan="2" class="px-6 py-3 text-sm font-bold text-slate-900 uppercase">
                {priser.tilleggsBygg.tittel}
              </td>
            </tr>
            <tr>
              <td class="px-6 py-3 text-sm text-gray-700">
                {priser.tilleggsBygg.navn}
              </td>
              <td class="px-6 py-3 text-sm font-semibold text-gray-900">
                {priser.tilleggsBygg.pris}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-12 prose max-w-none">
      <div class="p-6 bg-blue-50 border border-blue-100 rounded-xl text-slate-700 space-y-3">
        <p><strong>Bolig:</strong> enebolig, fritidsbolig, rekkehus, halvpart-2-mannsbolig og ¼-part 4-mannsbolig.</p>
        <p><strong>Leilighet:</strong> vurdering av boenhet uten fellesdeler utenfor leilighetens bruksareal (BRA).</p>
        <p class="text-sm italic text-slate-500">
          * Prisen gjelder i utgangspunktet boliger opp til ca 250-300 m². Be om pris ved boliger større enn 300 m² eller ved boliger av mer spesiell karakter.
        </p>
      </div>
    </section>

    <section class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-12">
      {priser.tjenesteKort.map((kort) => (
        <div class="card p-6 bg-white border border-gray-200 rounded-2xl shadow-sm flex flex-col justify-between">
          <div>
            <h2 class="text-xl font-bold text-slate-900 mb-2">{kort.tittel}</h2>
            {kort.info && <p class="text-sm text-slate-600 mb-4">{kort.info}</p>}
            
            <div class="space-y-4">
              {kort.typer ? (
                kort.typer.map((type, index) => (
                  <div>
                    <div class="flex justify-between items-end">
                      <span class="text-sm text-slate-600">{type.label}</span>
                      <span class="text-xl font-bold text-slate-900">kr {type.pris}</span>
                    </div>
                    {index < kort.typer!.length - 1 && <hr class="mt-2 border-gray-100" />}
                  </div>
                ))
              ) : (
                <div class="mt-2">
                  <div class="text-2xl font-bold text-slate-900">
                    kr {kort.pris} <span class="text-sm font-normal text-slate-500">{kort.enhet}</span>
                  </div>
                </div>
              )}
            </div>
          </div>
          <p class="text-xs text-slate-400 mt-6 italic">Inkludert mva</p>
        </div>
      ))}
    </section>

    <aside class="p-8 bg-slate-100 rounded-2xl text-center text-white shadow-lg">
      <h3 class="text-xl font-bold mb-3">
        Finner du ikke det du leter etter eller har en spesiell eiendom?
      </h3>
      <p class="text-slate-300 mb-6 max-w-2xl mx-auto">
        Ta kontakt med oss — oppgi gjerne adresse og hvilken type tjeneste du er ute etter, så kommer vi tilbake med et uforpliktende tilbud.
      </p>
      <a href="/kontakt" class="inline-block bg-blue-600 hover:bg-blue-500 text-white! font-bold py-3 px-8 rounded-lg transition-colors">
        Kontakt oss
      </a>
    </aside>
  </article>
</Layout>