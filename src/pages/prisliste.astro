---
import Layout from "../layouts/Layout.astro";
import priserData from "../data/priser.json";
import PageHeader from "../components/PageHeader.astro";

// TypeScript-definisjoner
interface PrisElement {
  navn: string;
  pris: string;
  bold?: boolean;
  italic?: boolean;
}

interface KortType {
  label: string;
  pris: string;
}

interface TjenesteKort {
  tittel: string;
  info?: string;
  pris?: string;
  enhet?: string;
  typer?: KortType[];
}

interface PrisData {
  tabellPriser: {
    kategori: string;
    elementer: PrisElement[];
    fotnote?: string;
  }[];
  tilleggsBygg: {
    tittel: string;
    navn: string;
    pris: string;
  };
  tjenesteKort: TjenesteKort[];
}

const priser = priserData as PrisData;
const title = "Prisliste — Frøyen Takst";
const description =
  "Prisliste for tjenester fra Frøyen Takst. Se våre veiledende fra-priser for tilstandsrapport, verditakst og skadetakst i Bergen og omegn.";

/** * Hjelpefunksjon for å avgjøre om vi skal vise "Fra"
 * Sjekker om prisen er numerisk og om det ikke er en timepris
 */
const shouldShowFra = (pris: string, enhet?: string) => {
  const p = pris.toLowerCase();
  const e = enhet?.toLowerCase() || "";

  // Ikke vis "Fra" hvis prisen inneholder tekst som "avtale" eller "forespørsel"
  if (p.includes("avtale") || p.includes("forespørsel")) return false;

  // Ikke vis "Fra" på timepriser
  if (e.includes("time") || p.includes("time")) return false;

  return true;
};

/**
 * Hjelpefunksjon for å formatere selve prisstrengen
 */
const formatPrice = (pris: string) => {
  if (pris.toLowerCase().includes("avtale")) return pris;
  return `kr ${pris}`;
};
---

<Layout {title} {description}>
  <article class="max-w-6xl mx-auto px-4 py-16 md:py-24">
    <PageHeader
      title="Prisliste"
      description="Her er ein oversikt over våre veiledende priser. Endelig pris fastsettes basert på oppdragets omfang og eiendommens størrelse. Alle priser inkluderer mva."
    />
    <section class="mb-16">
      <div
        class="elevation-3d rounded-2xl overflow-hidden border border-slate-200"
      >
        <table class="min-w-full divide-y divide-slate-200 bg-white">
          <thead class="bg-slate-50">
            <tr>
              <th
                scope="col"
                class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-widest"
              >
                Priskategori
              </th>
              <th
                scope="col"
                class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-widest"
              >
                Pris
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {
              priser.tabellPriser.map((kat) => (
                <>
                  <tr class="bg-slate-50/80">
                    <td
                      colspan="2"
                      class="px-6 py-4 text-sm font-extrabold text-primary uppercase tracking-wider"
                    >
                      {kat.kategori}
                    </td>
                  </tr>
                  {kat.elementer.map((item) => (
                    <tr class="hover:bg-blue-50/30 transition-colors">
                      <td
                        class={`px-6 py-4 text-sm text-slate-700 ${item.bold ? "font-bold" : ""} ${item.italic ? "italic" : ""}`}
                      >
                        {item.navn}
                      </td>
                      <td class="px-6 py-4 text-sm font-bold text-slate-900 whitespace-nowrap">
                        {shouldShowFra(item.pris) && (
                          <span class="text-[10px] font-bold text-slate-300 uppercase italic mr-1">
                            Fra
                          </span>
                        )}
                        {formatPrice(item.pris)}
                      </td>
                    </tr>
                  ))}
                  {kat.fotnote && (
                    <tr>
                      <td
                        colspan="2"
                        class="px-6 py-4 text-xs text-slate-400 italic leading-relaxed bg-white"
                      >
                        {kat.fotnote}
                      </td>
                    </tr>
                  )}
                </>
              ))
            }

            {/* Tilleggsbygg */}
            <tr class="bg-slate-50/80">
              <td
                colspan="2"
                class="px-6 py-4 text-sm font-extrabold text-primary uppercase tracking-wider"
              >
                {priser.tilleggsBygg.tittel}
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-sm text-slate-700">
                {priser.tilleggsBygg.navn}
              </td>
              <td class="px-6 py-4 text-sm font-bold text-slate-900">
                {
                  shouldShowFra(priser.tilleggsBygg.pris) && (
                    <span class="text-[10px] font-bold text-slate-300 uppercase italic mr-1">
                      Fra
                    </span>
                  )
                }
                {formatPrice(priser.tilleggsBygg.pris)}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-16">
      <div
        class="p-8 bg-white border-l-4 border-primary elevation-3d rounded-xl"
      >
        <div class="grid md:grid-cols-2 gap-8 text-slate-700">
          <div>
            <p class="font-bold text-slate-900 mb-2">Bolig:</p>
            <p class="text-sm">
              Enebolig, fritidsbolig, rekkehus, halvpart-2-mannsbolig og ¼-part
              4-mannsbolig.
            </p>
          </div>
          <div>
            <p class="font-bold text-slate-900 mb-2">Leilighet:</p>
            <p class="text-sm">
              Vurdering av boenhet uten fellesdeler utenfor leilighetens
              bruksareal (BRA).
            </p>
          </div>
        </div>
        <p
          class="mt-6 text-xs italic text-slate-400 border-t border-slate-100 pt-4"
        >
          * Prisen gjelder i utgangspunktet boliger opp til ca 250-300 m². Be om
          pris ved boliger større enn 300 m² eller ved boliger av mer spesiell
          karakter.
        </p>
      </div>
    </section>

    <section class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 mb-16">
      {
        priser.tjenesteKort.map((kort) => (
          <div class="card-base border-t-4 border-t-primary flex flex-col">
            <div class="flex flex-col h-full">
              <h2 class="text-xl font-bold text-slate-900 mb-3">
                {kort.tittel}
              </h2>
              {kort.info && (
                <p class="text-sm text-slate-500 mb-6 italic leading-relaxed">
                  {kort.info}
                </p>
              )}

              <div class="space-y-4">
                {kort.typer ? (
                  kort.typer.map((type, index) => (
                    <div>
                      <div class="flex justify-between items-baseline">
                        <span class="text-xs font-medium text-slate-400 uppercase tracking-tight">
                          {type.label}
                        </span>
                        <div class="flex items-baseline gap-1">
                          {shouldShowFra(type.pris) && (
                            <span class="text-[10px] font-bold text-slate-300 uppercase italic">
                              Fra
                            </span>
                          )}
                          <span class="text-lg font-bold text-primary">
                            {formatPrice(type.pris)}
                          </span>
                        </div>
                      </div>
                      {index < kort.typer!.length - 1 && (
                        <hr class="mt-2 border-slate-50" />
                      )}
                    </div>
                  ))
                ) : (
                  <div class="mt-2 pt-4 border-t border-slate-50">
                    <div class="text-3xl font-black text-primary flex items-baseline gap-2">
                      {shouldShowFra(kort.pris || "", kort.enhet) && (
                        <span class="text-xs font-bold text-slate-300 uppercase italic">
                          Fra
                        </span>
                      )}
                      {formatPrice(kort.pris || "")}
                      <span class="text-xs font-normal text-slate-400 uppercase ml-1">
                        {kort.enhet}
                      </span>
                    </div>
                  </div>
                )}
              </div>

              {/* Dette elementet vil nå alltid ligge helt nederst */}
              <p class="text-[10px] text-slate-400 mt-auto pt-8 uppercase tracking-widest font-bold italic">
                Inkludert mva
              </p>
            </div>
          </div>
        ))
      }
    </section>

    <aside
      class="p-10 bg-primary rounded-3xl text-center text-white elevation-3d border-none"
    >
      <h3 class="text-2xl font-bold mb-4 italic">
        Finner du ikke det du leter etter?
      </h3>
      <p class="text-blue-100/80 mb-8 max-w-2xl mx-auto leading-relaxed">
        Ta kontakt med oss — oppgi gjerne adresse og hvilken type tjeneste du er
        ute etter, så kommer vi tilbake med et uforpliktende tilbud.
      </p>
      <a href="/kontakt" class="btn-white"> Kontakt oss </a>
    </aside>
  </article>
</Layout>
