---
/* Her kan du legge til eventuell server-side logikk senere */
---

<form
    id="contact-form"
    class="space-y-4"
    method="post"
    action="#"
    novalidate
>
    <input type="hidden" name="form-name" value="contact" />

    <div>
        <label for="name" class="block text-sm font-medium text-slate-700">Navn</label>
        <input
            id="name"
            name="name"
            type="text"
            required
            class="form-input mt-1"
            placeholder="Fullt navn"
        />
    </div>

    <div class="grid md:grid-cols-2 gap-4">
        <div>
            <label for="email" class="block text-sm font-medium text-slate-700">E-post</label>
            <input
                id="email"
                name="email"
                type="email"
                required
                class="form-input mt-1"
                placeholder="din@mail.no"
            />
        </div>

        <div>
            <label for="phone" class="block text-sm font-medium text-slate-700">Telefon</label>
            <input
                id="phone"
                name="phone"
                type="tel"
                class="form-input mt-1"
                placeholder="+47 9X XX XX XX"
            />
        </div>
    </div>

    <div>
        <label for="message" class="block text-sm font-medium text-slate-700">Melding</label>
        <textarea
            id="message"
            name="message"
            rows="6"
            class="form-textarea mt-1"
            placeholder="Fortell kort om eiendommen og hva du ønsker hjelp med"
        ></textarea>
    </div>

    <div class="flex items-start gap-3">
        <input
            id="consent"
            name="consent"
            type="checkbox"
            required
            class="mt-1"
        />
        <label for="consent" class="text-sm text-slate-600">
            Jeg samtykker til at opplysningene sendes for å få et svar fra Frøyen Takst.
        </label>
    </div>

    <div class="flex items-center gap-4">
        <button type="submit" class="btn-primary">Send melding</button>
    </div>

    <div id="form-status" role="status" class="mt-4 text-sm font-medium hidden"></div>
</form>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const status = document.getElementById("form-status");

    if (form && status) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const formData = new FormData(form);
            const name = formData.get("name");
            const email = formData.get("email");
            const consent = formData.get("consent");

            if (!name || !email || !consent) {
                status.textContent = "Vennligst fyll ut navn, e-post og samtykke.";
                status.classList.remove("hidden");
                status.className = "mt-4 text-sm font-medium text-amber-700";
                return;
            }

            status.textContent = "Sender...";
            status.classList.remove("hidden");
            status.className = "mt-4 text-sm font-medium text-slate-600";

            try {
                // Her kan du legge inn faktisk fetch mot API eller Netlify
                await new Promise((res) => setTimeout(res, 800));
                status.textContent = "Takk! Meldingen er sendt. Vi tar kontakt så snart som mulig.";
                status.className = "mt-4 text-sm font-medium text-emerald-700";
                form.reset();
            } catch (err) {
                status.textContent = "Noe gikk galt. Vennligst prøv igjen eller ring oss direkte.";
                status.className = "mt-4 text-sm font-medium text-red-700";
            }
        });
    }
</script>