---
/* Her kan du legge til eventuell server-side logikk senere */
---

<form
    id="contact-form"
    class="space-y-4"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    name="kontakt-skjema"
>
    <input type="hidden" name="form-name" value="kontakt-skjema" />
    <p class="hidden">
        <label>Ikke fyll ut dette hvis du er eit menneske: <input name="bot-field" /></label>
    </p>

    <div>
        <label for="name" class="block text-sm font-medium text-slate-700">Navn</label>
        <input
            id="name"
            name="name"
            type="text"
            required
            class="form-input mt-1 w-full"
            placeholder="Fullt navn"
        />
    </div>

    <div class="grid md:grid-cols-2 gap-4">
        <div>
            <label for="email" class="block text-sm font-medium text-slate-700">E-post</label>
            <input
                id="email"
                name="email"
                type="email"
                required
                class="form-input mt-1 w-full"
                placeholder="din@mail.no"
            />
        </div>

        <div>
            <label for="phone" class="block text-sm font-medium text-slate-700">Telefon</label>
            <input
                id="phone"
                name="phone"
                type="tel"
                class="form-input mt-1 w-full"
                placeholder="+47 9X XX XX XX"
            />
        </div>
    </div>

    <div>
        <label for="message" class="block text-sm font-medium text-slate-700">Melding</label>
        <textarea
            id="message"
            name="message"
            rows="6"
            class="form-textarea mt-1 w-full"
            placeholder="Fortell kort om eiendommen og hva du ønsker hjelp med"
        ></textarea>
    </div>

    <div class="flex items-start gap-3 w-full">
        <input
            id="consent"
            name="consent"
            type="checkbox"
            required
            class="mt-1 h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary"
        />
        <label for="consent" class="text-sm text-slate-600 leading-tight">
            Jeg samtykker til at opplysningene sendes for å få et svar fra Frøyen Takst.
        </label>
    </div>

    <div class="flex items-center gap-4">
        <button type="submit" class="btn-primary">Send melding</button>
    </div>

    <div id="form-status" role="status" class="mt-4 text-sm font-medium hidden"></div>
</form>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const status = document.getElementById("form-status");

    if (form && status) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const formData = new FormData(form);
            
            // Validering
            if (!formData.get("name") || !formData.get("email") || !formData.get("consent")) {
                status.textContent = "Vennligst fyll ut navn, e-post og samtykke.";
                status.className = "mt-4 text-sm font-medium text-amber-700";
                status.classList.remove("hidden");
                return;
            }

            status.textContent = "Sender melding...";
            status.className = "mt-4 text-sm font-medium text-slate-600";
            status.classList.remove("hidden");

            try {
                // Her sender vi data til Netlify sin "usynlege" endpoint
                const response = await fetch("/", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: new URLSearchParams(formData as any).toString(),
                });

                if (response.ok) {
                    status.textContent = "Takk! Meldingen er sendt. Vi tar kontakt så snart som mulig.";
                    status.className = "mt-4 text-sm font-medium text-emerald-700";
                    form.reset();
                } else {
                    throw new Error();
                }
            } catch (err) {
                status.textContent = "Noe gikk galt. Vennligst prøv igjen eller send oss en e-post direkte.";
                status.className = "mt-4 text-sm font-medium text-red-700";
            }
        });
    }
</script>