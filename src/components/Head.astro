---
// src/components/Head.astro
interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/images/froyenTakst.png' } = Astro.props;

/** * Vi definerer basen for alle absolutte URL-ar.
 * 1. Vi sjekkar først Astro.site (frå astro.config.mjs).
 * 2. Som reserve brukar vi Astro.url.origin (fungerer bra på Netlify og lokalt).
 */
const siteBase = Astro.site ? Astro.site.origin : Astro.url.origin;

// Vi lagar absolutte URL-ar som sosiale medium krev
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;
const socialImageURL = new URL(image, siteBase).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Frøyen Takst" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="sitemap" href="/sitemap-index.xml" />