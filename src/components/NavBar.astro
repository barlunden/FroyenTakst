---
import { getCollection } from 'astro:content';

// Hent alle tenester og sorter dei etter 'order' feltet frå frontmatter
const tjenester = await getCollection('tjenester');
const sorterteTjenester = tjenester.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<header class="bg-white/60 backdrop-blur-sm border-b sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8">
    <div class="flex items-center justify-between h-28">
      <a
        href="/"
        class="flex items-center gap-3 rounded-md shadow-slate-500/50 hover:scale-101 transition-all shadow-lg"
      >
        <span class="inline-flex items-center justify-center bg-[#0f3b66] rounded-md p-2">
          <img
            src="/froyen_logo.webp"
            alt="Frøyen Takst"
            class="site-logo h-14! md:h-18!"
          />
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-6 text-md font-medium">
        <a href="/" class="text-slate-700 hover:text-[#0f3b66]">Forside</a>

        <div class="relative group">
          <a
            href="/tjenester"
            class="text-slate-700 hover:text-[#0f3b66] flex items-center gap-1 py-4"
          >
            Tjenester
            <svg
              class="h-4 w-4 transform transition-transform duration-200 group-hover:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div
            class="absolute hidden group-hover:block bg-white shadow-xl rounded-xl top-[90%] left-0 py-3 w-64 border border-slate-100 z-10 animate-in fade-in slide-in-from-top-2 duration-200"
          >
            {sorterteTjenester.map((t) => (
              <a
                href={`/tjenester/${t.slug}`}
                class="block px-5 py-2.5 text-sm text-slate-700 hover:bg-slate-50 hover:text-[#0f3b66] transition-colors"
              >
                {t.data.title}
              </a>
            ))}
          </div>
        </div>

        <a href="/prisliste" class="text-slate-700 hover:text-[#0f3b66]">Prisliste</a>
        <a href="/faq" class="text-slate-700 hover:text-[#0f3b66]">FAQ</a>
        <a
          href="/kontakt"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#0f3b66] text-white! rounded-lg shadow-md hover:bg-[#0d3358] transition-all hover:scale-105 active:scale-95"
        >
          Kontakt
        </a>
      </nav>

      <div class="md:hidden">
        <button
          id="menu-toggle"
          aria-label="Åpne meny"
          class="p-2.5 rounded-lg border border-slate-200 bg-white shadow-sm active:bg-slate-50"
        >
          <svg class="h-6 w-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t bg-white">
  <div class="px-6 py-6 space-y-4">
    <a href="/" class="block text-lg font-semibold text-slate-900">Hjem</a>
    
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-widest text-slate-400 font-bold">Våre tjenester</p>
      <div class="grid grid-cols-1 gap-1 pl-2 border-l-2 border-slate-100">
        {sorterteTjenester.map((t) => (
          <a
            href={`/tjenester/${t.slug}`}
            class="block py-2 text-slate-600 hover:text-[#0f3b66]"
          >
            {t.data.title}
          </a>
        ))}
      </div>
    </div>

    <div class="pt-4 space-y-4 border-t border-slate-100">
      <a href="/prisliste" class="block text-slate-700 font-medium">Prisliste</a>
      <a href="/faq" class="block text-slate-700 font-medium">Ofte stilte spørsmål</a>
      <a
        href="/kontakt"
        class="block py-3 px-4 bg-[#0f3b66] text-white text-center rounded-xl font-bold"
      >
        Kontakt oss
      </a>
    </div>
  </div>
</div>
</header>

<script is:inline>
  // Funksjon for å kople opp menyen
  function initMenu() {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");

    if (toggle && menu) {
      // Vi fjernar eventuelle gamle listeners ved å erstatte knappen (viktig i Astro)
      const newToggle = toggle.cloneNode(true);
      toggle.parentNode.replaceChild(newToggle, toggle);

      newToggle.addEventListener("click", (e) => {
        e.preventDefault();
        menu.classList.toggle("hidden");
        console.log("Meny trykka!"); // Sjekk i konsollen på mobilen om denne dukkar opp
      });
    }
  }

  // Køyr når DOM er klar
  document.addEventListener("DOMContentLoaded", initMenu);
  // Køyr viss du brukar View Transitions
  document.addEventListener("astro:after-swap", initMenu);
  // Køyr med ein gong for sikkerheits skuld
  initMenu();
</script>