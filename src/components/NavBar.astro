<header class="bg-white/60 backdrop-blur-sm border-b sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8">
    <div class="flex items-center justify-between h-28">
      <a
        href="/"
        class="flex items-center gap-3 rounded-md shadow-slate-500/50 hover:scale-101 transition-all shadow-lg"
      >
        <!-- Logo image -->
        <span
          class="inline-flex items-center justify-center bg-[#0f3b66] rounded-md p-2"
        >
          <img
            src="/froyen_logo.webp"
            alt="Frøyen Takst"
            class="site-logo h-14! md:h-18!"
          />
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-6 text-md">
        <a href="/" class="text-slate-700 hover:text-[#0f3b66]">Forside</a>

        <!-- Tjenester Dropdown -->
        <div class="relative group">
          <a
            href="/tjenester"
            class="text-slate-700 hover:text-[#0f3b66] flex items-center gap-1"
          >
            Tjenester
            <svg
              class="h-4 w-4 transform transition-transform duration-200 group-hover:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
          <div
            class="absolute hidden group-hover:block bg-white shadow-lg rounded-md top-full left-0 py-2 w-60 border z-10"
          >
            <a
              href="/tjenester/tilstandsrapport"
              class="block px-4 py-2 text-sm text-slate-700 hover:bg-gray-100"
              >Tilstandsrapport</a
            >
            <a
              href="/tjenester/reklamasjon-skadetakst"
              class="block px-4 py-2 text-sm text-slate-700 hover:bg-gray-100"
              >Reklamasjon og Skadetakst</a
            >
            <a
              href="/tjenester/verdi-lanetakst"
              class="block px-4 py-2 text-sm text-slate-700 hover:bg-gray-100"
              >Verdi- og Lånetakst</a
            >
            <a
              href="/tjenester/forenklet-lanetakst"
              class="block px-4 py-2 text-sm text-slate-700 hover:bg-gray-100"
              >Forenklet Lånetakst</a
            >
          </div>
        </div>

        <a href="/prisliste" class="text-slate-700 hover:text-[#0f3b66]"
          >Prisliste</a
        >
        <a href="/faq" class="text-slate-700 hover:text-[#0f3b66]"
          >Ofte stilte spørsmål</a
        >
        <a
          href="/kontakt"
          class="inline-flex items-center gap-2 px-3 py-2 bg-[#0f3b66] text-white! rounded-md shadow-sm hover:bg-[#0d3358]"
          >Kontakt</a
        >
      </nav>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button
          id="menu-toggle"
          aria-label="Åpne meny"
          class="p-2 rounded-md border bg-white"
        >
          <svg
            class="h-5 w-5 text-slate-700"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav (hidden by default) -->
  <div id="mobile-menu" class="md:hidden hidden border-t bg-white">
    <div class="px-4 py-4 space-y-2">
      <a href="/" class="block py-2 text-slate-700 hover:text-[#0f3b66]">Hjem</a
      >
      <div>
        <a href="/tjenester" class="block py-2 font-semibold text-slate-700"
          >Tjenester</a
        >
        <div class="pl-4 border-l-2 border-slate-200">
          <a
            href="/tjenester/tilstandsrapport"
            class="block py-2 text-slate-600 hover:text-[#0f3b66]"
            >Tilstandsrapport</a
          >
          <a
            href="/tjenester/reklamasjon-skadetakst"
            class="block py-2 text-slate-600 hover:text-[#0f3b66]"
            >Reklamasjon og Skadetakst</a
          >
          <a
            href="/tjenester/verdi-lanetakst"
            class="block py-2 text-slate-600 hover:text-[#0f3b66]"
            >Verdi- og Lånetakst</a
          >
          <a
            href="/tjenester/forenklet-lanetakst"
            class="block py-2 text-slate-600 hover:text-[#0f3b66]"
            >Forenklet Lånetakst</a
          >
        </div>
      </div>
      <a
        href="/prisliste"
        class="block py-2 text-slate-700 hover:text-[#0f3b66]">Prisliste</a
      >
      <a href="/faq" class="block py-2 text-slate-700 hover:text-[#0f3b66]"
        >Ofte stilte spørsmål</a
      >
      <a
        href="/kontakt"
        class="block py-2 px-3 bg-[#0f3b66] text-white rounded-md w-max"
        >Kontakt</a
      >
    </div>
  </div>
</header>
<script type="module">
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }
</script>
