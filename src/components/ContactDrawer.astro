---
/* ContactDrawer.astro */
import ContactForm from "./ContactForm.astro";
---

<div id="drawer-overlay" class="fixed inset-0 bg-slate-900/60 z-9998 opacity-0 pointer-events-none transition-opacity duration-300"></div>

<div 
  id="contact-drawer" 
  class="fixed top-0 right-0 h-full w-full max-w-lg bg-white z-9999 shadow-2xl translate-x-full transition-transform duration-500 ease-in-out overflow-y-auto text-left"
>
  <div class="p-8 sm:p-10">
    <div class="flex justify-between items-center mb-8 border-b border-slate-200 pb-4">
      <div>
        <h2 class="text-2xl font-bold text-slate-900 italic m-0 p-0">Kontakt oss</h2>
        <p class="text-slate-500 text-sm mt-1">Frøyen Takst AS</p>
      </div>
      <button id="close-drawer" class="p-2 hover:bg-slate-100 rounded-full transition-colors border-none bg-transparent cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="space-y-6 mb-10">
       <div class="border-l-4 border-accent pl-6 py-2">
          <h2 class="font-bold text-slate-900">Praktisk ved bestilling</h2>
          <p class="text-sm text-slate-600 mt-2">Oppgi gjerne adresse og eiendomstype for raskere estimat.</p>
       </div>
    </div>

    <div class="drawer-form-wrapper">
      <ContactForm />
    </div>
  </div>
</div>

<script>
  function setupDrawer() {
    // Vi ser etter alle element med denne klassen
    const openBtns = document.querySelectorAll('.trigger-contact-drawer');
    const closeBtn = document.getElementById('close-drawer');
    const overlay = document.getElementById('drawer-overlay');
    const drawer = document.getElementById('contact-drawer');

    function toggleDrawer(e: Event) {
      if(e) e.preventDefault();
      if (drawer && overlay) {
        drawer.classList.toggle('translate-x-full');
        overlay.classList.toggle('opacity-0');
        overlay.classList.toggle('pointer-events-none');
        document.body.classList.toggle('overflow-hidden');
      }
    }

    openBtns.forEach(btn => btn.addEventListener('click', toggleDrawer));
    closeBtn?.addEventListener('click', toggleDrawer);
    overlay?.addEventListener('click', toggleDrawer);
  }

  // Setup ved oppstart
  setupDrawer();
  // Viss du brukar View Transitions (Astro)
  document.addEventListener('astro:after-swap', setupDrawer);
</script>